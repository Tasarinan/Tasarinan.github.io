{
  "name": "tasarinan-docs",
  "private": true,
  "devDependencies": {
    "vitepress": "2.0.0-alpha.17"
  },
  "scripts": {
    "docs:gen": "node scripts/generate-vitepress-structure.mjs",
    "dev": "npm run docs:dev",
    "build": "npm run docs:build",
